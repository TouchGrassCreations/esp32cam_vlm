# openai or ollama
VLM_PROVIDER=openai

# OpenAI-compatible API
OPENAI_API_KEY=
VLM_MODEL=

# Ollama option
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Ask the VLM to describe the scene
VLM_PROMPT=Describe what is happening in this image. Focus on people, posture, objects, unusual events, and anything that may require attention. Be concise.
